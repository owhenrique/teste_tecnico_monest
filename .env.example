# Modelo de configuração. Copie para .env antes de subir a aplicação:

# Ambiente de execução: development | test | staging | production
NODE_ENV=development

# Porta HTTP. Inteiro entre 1 e 65535.
PORT=3000

# Timeout de cada provedor de CEP, em ms. Inteiro positivo.
PROVIDER_TIMEOUT_MS=2500

# Falhas consecutivas que abrem o circuito de um provedor. Inteiro positivo.
CIRCUIT_FAILURE_THRESHOLD=3

# Tempo que o circuito fica aberto antes de voltar a fechar, em ms. Inteiro positivo.
CIRCUIT_RESET_MS=30000

# Piso de severidade do log: fatal | error | warn | info
LOG_LEVEL=info
