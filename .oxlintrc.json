{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "pedantic": "off"
  },
  "env": { "node": true, "es2023": true },
  "rules": {
    "typescript/no-extraneous-class": ["error", { "allowWithDecorator": true }]
  },
  "ignorePatterns": ["dist", "node_modules", "coverage"]
}
