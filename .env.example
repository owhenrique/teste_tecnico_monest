# Porta HTTP da aplicação.
PORT=3000

# Ambiente de execução: development | test | Staging | production
NODE_ENV=development

# Timeout de cada provedor de CEP, em ms. Com 2 provedores, a request leva até 2x isso.
PROVIDER_TIMEOUT_MS=2500

# Falhas consecutivas que abrem o circuito de um provedor.
CIRCUIT_FAILURE_THRESHOLD=3

# Tempo que o circuito fica aberto antes de voltar a fechar, em ms.
CIRCUIT_RESET_MS=30000
